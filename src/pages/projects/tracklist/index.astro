---
import PageLayout from '../../../layouts/PageLayout.astro';
---

<PageLayout title="Tracklist — Clemente Lacerda" description="Extract tracklists from DJ sets on YouTube and export matched songs to Spotify.">
  <section class="tracklist-page">

    <div id="libraryLayout" class="library-layout">
      <!-- My Sets Library (left column in library view) -->
      <div id="librarySection" class="library-section hidden">
        <div class="library-header">
          <h2 class="library-title">My Sets</h2>
          <div class="library-controls">
            <input type="text" id="librarySearch" placeholder="Search tracks, artists, channels..."
                   class="library-search" autocomplete="off" />
          </div>
        </div>
        <div id="libraryList" class="library-list"></div>
        <div id="libraryEmpty" class="library-empty hidden">
          <p>No saved sets yet.</p>
          <p class="library-empty-hint">Extract a DJ set and it will appear here automatically.</p>
        </div>
      </div>

      <!-- Atmosphere: Quotes + Input (right column in library view) -->
      <div id="atmosphere" class="atmosphere">
        <div class="quotes">
          <blockquote class="atmosphere-quote">
            <p>"Music is the shorthand of emotion."</p>
            <cite>Leo Tolstoy</cite>
          </blockquote>
          <blockquote class="atmosphere-quote">
            <p>"Without music, life would be a mistake."</p>
            <cite>Friedrich Nietzsche</cite>
          </blockquote>
        </div>

        <p id="extractLabel" class="extract-label">Extract a set</p>

        <form id="extractForm" class="url-input-form">
          <label for="youtube-url" class="visually-hidden">YouTube URL</label>
          <div class="input-wrapper">
            <input
              type="url"
              id="youtube-url"
              name="url"
              placeholder="Paste a YouTube DJ set link"
              required
              autocomplete="off"
            />
            <div class="input-underline"></div>
          </div>
          <button type="submit" class="visually-hidden" tabindex="-1">Extract</button>
        </form>
        <p class="input-hint">Works best with Cercle, Boiler Room, Anjunadeep, and sets that list timestamps.</p>
        <div id="spotifyConnectRow" class="spotify-connect-row">
          <button id="spotifyConnectBtn" class="spotify-connect-btn" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
            Connect Spotify
          </button>
          <span id="spotifyConnectStatus" class="spotify-connect-status"></span>
        </div>
        <p id="tracklistNotice" class="input-notice hidden" role="status" aria-live="polite"></p>
        <p id="libraryLink" class="library-link hidden">
          <button id="openLibraryBtn" class="library-link-btn">
            My Sets (<span id="libraryCountBadge">0</span>)
          </button>
        </p>
      </div>
    </div>

    <!-- iPod Stage -->
    <div id="ipodStage" class="ipod-stage hidden">
      <canvas id="confettiCanvas" class="confetti-canvas" width="0" height="0"></canvas>

      <!-- Results header: full width above side-by-side -->
      <div id="resultsHeader" class="results-header hidden">
        <div class="results-meta">
          <h2 id="setTitle" class="set-title"></h2>
          <span id="librarySavedLabel" class="library-saved-label hidden">Saved to My Sets</span>
          <p class="set-info">
            <span id="channelName" class="channel-name"></span>
            <span id="tracklistSource" class="tracklist-source hidden"></span>
            <span class="track-count-badge"><span id="trackCount"></span> tracks</span>
            <span id="selectionSummary" class="selection-summary">Selected 0 • Ready 0 • Unresolved 0</span>
            <label class="select-all-label"><input type="checkbox" id="selectAll" class="track-select" /> Select all</label>
          </p>
        </div>
        <div class="results-actions">
          <button id="exportSpotifyBtn" class="primary-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
            Export to Spotify
          </button>
          <span id="exportSelectionPill" class="export-selection-pill">0 selected</span>
          <span id="exportStatusInline" class="export-status-inline hidden">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
            <span id="exportStatusMessage"></span>
            <a id="exportPlaylistLink" href="#" target="_blank" rel="noopener" class="export-playlist-link"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg> Open in Spotify</a>
          </span>
          <button id="newSearchBtn" class="secondary-btn">Extract another</button>
          <button id="resultsLibraryBtn" class="secondary-btn library-results-btn hidden">My Sets (<span id="resultsLibraryCount">0</span>)</button>
        </div>
      </div>

      <!-- Side-by-side: iPod + tracklist -->
      <div class="ipod-and-list">
        <div class="ipod-column">
          <!-- iPod Classic -->
          <div class="ipod-classic" id="ipodClassic" aria-label="iPod Classic displaying tracklist">
            <div class="ipod-chrome-edge"></div>
            <div class="ipod-body">
              <!-- Screen housing -->
              <div class="ipod-screen-housing">
                <span class="ipod-label">iPod</span>
                <div class="ipod-screen">
                  <div class="ipod-screen-overlay is-off" id="ipodOverlay">
                    <div class="ipod-power-line" id="ipodPowerLine"></div>
                  </div>
                  <div class="ipod-lcd-glow"></div>
                  <div class="ipod-screen-content" id="ipodScreenContent">
                    <!-- Loading -->
                    <div class="ipod-loading" id="ipodLoading">
                      <div class="ipod-spinner"></div>
                      <span class="ipod-loading-text" id="ipodLoadingText">Scanning...</span>
                    </div>
                    <!-- Playlist -->
                    <div class="ipod-playlist" id="ipodPlaylist" style="display:none">
                      <div class="ipod-header-bar">
                        <span class="ipod-header-title" id="ipodSetTitle">Tracklist</span>
                      </div>
                      <div class="ipod-song-list-wrapper">
                        <ul class="ipod-song-list" id="ipodSongList"></ul>
                        <div class="ipod-scrollbar">
                          <div class="ipod-scrollbar-thumb" id="ipodScrollThumb"></div>
                        </div>
                      </div>
                    </div>
                    <!-- Error on screen -->
                    <div class="ipod-error" id="ipodError" style="display:none">
                      <span class="ipod-error-icon">!</span>
                      <span class="ipod-error-text" id="ipodErrorText"></span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Controls -->
              <div class="ipod-control-area">
                <div class="ipod-button-row">
                  <button class="ipod-btn" aria-label="Previous" tabindex="-1">◁◁</button>
                  <button class="ipod-btn" aria-label="Menu" tabindex="-1">MENU</button>
                  <button class="ipod-btn" aria-label="Play/Pause" tabindex="-1">▷ ||</button>
                  <button class="ipod-btn" aria-label="Next" tabindex="-1">▷▷</button>
                </div>
                <div class="ipod-wheel">
                  <button class="ipod-select" id="ipodSelect" aria-label="Select" tabindex="-1"></button>
                </div>
              </div>
            </div>
          </div>

          <!-- Spotify player -->
          <div id="spotifyPlayerCard" class="spotify-player-card hidden" aria-live="polite">
            <p id="spotifyPlayerStatus" class="spotify-player-status">Playback Ready</p>
            <p id="spotifyPlayerTrack" class="spotify-player-track">Select a matched track to play in Spotify.</p>
          </div>
          <!-- Hidden Spotify embed — must not be display:none or iframe won't load -->
          <div id="spotifyEmbedHost" class="spotify-embed-host spotify-embed-offscreen"></div>
        </div>

        <!-- Detail Tracklist -->
        <div id="detailSection" class="detail-section hidden">
          <ol id="tracklist" class="tracklist"></ol>
        </div>

        <!-- Error state (beside iPod on desktop, below on mobile) -->
        <div id="errorActions" class="error-actions hidden">
          <p class="error-title" id="errorVideoTitle"></p>
          <p class="error-message" id="errorMessage"></p>
          <button id="retryBtn" class="secondary-btn">Try another URL</button>
        </div>

      </div>

    </div>

  </section>
</PageLayout>

<script define:vars={{ PUBLIC_SPOTIFY_CLIENT_ID: import.meta.env.PUBLIC_SPOTIFY_CLIENT_ID || '' }}>
  window.__SPOTIFY_CLIENT_ID = PUBLIC_SPOTIFY_CLIENT_ID;
</script>

<script>
  import {
    generateRandomString,
    sha256Base64url,
    setOAuthStateCookie,
    clearOAuthStateCookie,
  } from '../../../scripts/tracklist/oauth';
  import {
    searchAllTracks,
    type SpotifyMatch,
  } from '../../../scripts/tracklist/spotify-search';
  import {
    saveSet,
    updateSetExport,
    loadLibrary,
    loadSet,
    deleteSet,
    getLibraryCount,
    searchLibrary,
    toTracklistData,
    getExportedUrisForSet,
  } from '../../../scripts/tracklist/library';

  async function initTracklist() {
    console.log('[tracklist] init');
    // --- DOM refs ---
    const atmosphere = document.getElementById('atmosphere');
    const ipodStage = document.getElementById('ipodStage');
    const resultsHeader = document.getElementById('resultsHeader');
    const detailSection = document.getElementById('detailSection');
    const errorActions = document.getElementById('errorActions');
    const tracklistNotice = document.getElementById('tracklistNotice');

    const ipodClassic = document.getElementById('ipodClassic');
    const ipodOverlay = document.getElementById('ipodOverlay');
    const ipodPowerLine = document.getElementById('ipodPowerLine');
    const ipodLoading = document.getElementById('ipodLoading');
    const ipodLoadingText = document.getElementById('ipodLoadingText');
    const ipodPlaylist = document.getElementById('ipodPlaylist');
    const ipodSongList = document.getElementById('ipodSongList');
    const ipodSetTitle = document.getElementById('ipodSetTitle');
    const ipodScrollThumb = document.getElementById('ipodScrollThumb');
    const ipodError = document.getElementById('ipodError');
    const ipodErrorText = document.getElementById('ipodErrorText');
    const spotifyPlayerCard = document.getElementById('spotifyPlayerCard');
    const spotifyPlayerStatus = document.getElementById('spotifyPlayerStatus');
    const spotifyPlayerTrack = document.getElementById('spotifyPlayerTrack');
    const spotifyEmbedHost = document.getElementById('spotifyEmbedHost');

    const form = document.getElementById('extractForm') as HTMLFormElement;
    const urlInput = document.getElementById('youtube-url') as HTMLInputElement;
    const errorMessage = document.getElementById('errorMessage');
    const errorVideoTitle = document.getElementById('errorVideoTitle');
    const setTitle = document.getElementById('setTitle');
    const channelName = document.getElementById('channelName');
    const trackCount = document.getElementById('trackCount');
    const tracklist = document.getElementById('tracklist');
    const retryBtn = document.getElementById('retryBtn');
    const newSearchBtn = document.getElementById('newSearchBtn');
    const exportSpotifyBtn = document.getElementById('exportSpotifyBtn');
    const selectAllEl = document.getElementById('selectAll') as HTMLInputElement | null;
    const selectionSummary = document.getElementById('selectionSummary');
    const exportSelectionPill = document.getElementById('exportSelectionPill');
    const exportStatusInline = document.getElementById('exportStatusInline');
    const exportStatusMessage = document.getElementById('exportStatusMessage');
    const exportPlaylistLink = document.getElementById('exportPlaylistLink') as HTMLAnchorElement | null;

    const librarySection = document.getElementById('librarySection');
    const libraryList = document.getElementById('libraryList');
    const libraryEmpty = document.getElementById('libraryEmpty');
    const librarySearch = document.getElementById('librarySearch') as HTMLInputElement | null;
    const libraryLink = document.getElementById('libraryLink');
    const libraryCountBadge = document.getElementById('libraryCountBadge');
    const openLibraryBtn = document.getElementById('openLibraryBtn');
    const resultsLibraryBtn = document.getElementById('resultsLibraryBtn');
    const resultsLibraryCount = document.getElementById('resultsLibraryCount');
    const libraryLayout = document.getElementById('libraryLayout');
    const extractLabel = document.getElementById('extractLabel');
    const librarySavedLabel = document.getElementById('librarySavedLabel');
    const spotifyConnectBtn = document.getElementById('spotifyConnectBtn');
    const spotifyConnectStatus = document.getElementById('spotifyConnectStatus');
    const spotifyConnectRow = document.getElementById('spotifyConnectRow');

    if (!form || !urlInput || !tracklist || !selectAllEl) return;
    if (form.dataset.tracklistBound === 'true') return;
    form.dataset.tracklistBound = 'true';

    let currentData: any = null;
    let selectedIPodIndex = 0;
    let playingIndex: number | null = null;
    let selectedForExport = new Set<number>();
    let exportedTracks = new Set<number>();
    let spotifyAccessToken: string | null = sessionStorage.getItem('spotify_access_token');
    let wheelDeltaAccumulator = 0;
    let lastWheelMoveAt = 0;
    const WHEEL_THRESHOLD = 50;
    const WHEEL_COOLDOWN_MS = 100;
    const DEFAULT_SPOTIFY_URI = 'spotify:track:11dFghVXANMlKmJXsNCbNl';
    let spotifyApiRequested = false;
    let spotifyEmbedController: any = null;
    let pendingSpotifyUri = '';
    let isSpotifyPlaying = false;
    let currentLoadedUri = '';

    function setNotice(message: string, tone: 'info' | 'error' | 'success' = 'info') {
      if (!tracklistNotice) return;

      if (!message) {
        tracklistNotice.className = 'input-notice hidden';
        tracklistNotice.textContent = '';
        return;
      }

      tracklistNotice.className = `input-notice ${tone}`;
      tracklistNotice.textContent = message;
    }

    function hasSpotifyUri(track: any): boolean {
      return Boolean(track?.spotify?.spotifyUri);
    }

    function getTrack(index: number): any | null {
      if (!currentData?.tracks?.length) return null;
      return currentData.tracks[index] ?? null;
    }

    function sanitizeSelectedSet() {
      if (!currentData?.tracks?.length) {
        selectedForExport.clear();
        return;
      }
      const maxIndex = currentData.tracks.length - 1;
      selectedForExport = new Set(
        [...selectedForExport].filter((idx) => idx >= 0 && idx <= maxIndex)
      );
    }


    function getSelectionMetrics() {
      sanitizeSelectedSet();
      const selectedCount = selectedForExport.size;
      const readyCount = [...selectedForExport].reduce((count, idx) => {
        const track = currentData?.tracks?.[idx];
        return count + (hasSpotifyUri(track) ? 1 : 0);
      }, 0);
      const unresolvedCount = Math.max(0, selectedCount - readyCount);
      return { selectedCount, readyCount, unresolvedCount };
    }

    function updatePlayerStatus(status: string, description: string) {
      if (spotifyPlayerStatus) spotifyPlayerStatus.textContent = status;
      if (spotifyPlayerTrack) spotifyPlayerTrack.textContent = description;
    }


    function updateExportCount() {
      const { selectedCount, readyCount, unresolvedCount } = getSelectionMetrics();

      if (selectionSummary) {
        selectionSummary.textContent = `Selected ${selectedCount} • Ready ${readyCount} • Unresolved ${unresolvedCount}`;
      }

      if (exportSelectionPill) {
        exportSelectionPill.textContent = `${selectedCount} selected`;
      }

      if (exportSpotifyBtn) {
        const btn = exportSpotifyBtn as HTMLButtonElement;
        btn.disabled = readyCount === 0;
      }

      if (currentData?.tracks?.length) {
        const total = currentData.tracks.length;
        selectAllEl.checked = selectedCount === total && total > 0;
        selectAllEl.indeterminate = selectedCount > 0 && selectedCount < total;
      } else {
        selectAllEl.checked = false;
        selectAllEl.indeterminate = false;
      }
    }

    // --- State management ---
    function showState(state: string) {
      // Always hide library section unless we're in library state
      librarySection?.classList.toggle('hidden', state !== 'library');

      // Two-column layout only in library state
      libraryLayout?.classList.toggle('is-library-view', state === 'library');
      extractLabel?.classList.toggle('hidden', state !== 'library' && state !== 'input');

      if (state === 'library') {
        atmosphere?.classList.remove('collapsed');
        ipodStage?.classList.add('hidden');
        resultsHeader?.classList.add('hidden');
        detailSection?.classList.add('hidden');
        errorActions?.classList.add('hidden');
        librarySavedLabel?.classList.add('hidden');
        libraryLink?.classList.add('hidden');
        urlInput.value = '';
        renderLibraryList();
        history.replaceState(null, '', '#library');
        return;
      }

      if (state === 'input') {
        atmosphere?.classList.remove('collapsed');
        ipodStage?.classList.add('hidden');
        resultsHeader?.classList.add('hidden');
        detailSection?.classList.add('hidden');
        errorActions?.classList.add('hidden');
        ipodClassic?.classList.remove('is-on');
        exportStatusInline?.classList.add('hidden');
        if (exportSelectionPill) exportSelectionPill.classList.remove('hidden');
        exportedTracks.clear();
        document.getElementById('tracklistSource')?.classList.add('hidden');
        librarySavedLabel?.classList.add('hidden');
        updateLibraryLink();
        history.replaceState(null, '', location.pathname);
        return;
      }

      // Everything else: collapse atmosphere, show iPod
      atmosphere?.classList.add('collapsed');
      ipodStage?.classList.remove('hidden');

      // iPod screen sub-states
      if (ipodLoading) ipodLoading.style.display = state === 'loading' ? '' : 'none';
      if (ipodPlaylist) ipodPlaylist.style.display = state === 'results' ? '' : 'none';
      if (ipodError) ipodError.style.display = state === 'error' ? '' : 'none';

      // Results header + detail section
      resultsHeader?.classList.toggle('hidden', state !== 'results');
      detailSection?.classList.toggle('hidden', state !== 'results');
      errorActions?.classList.toggle('hidden', state !== 'error');
      // Player card hidden for now — keep infrastructure intact
      spotifyPlayerCard?.classList.add('hidden');

      if (state === 'results') {
        updateLibraryLink();
        ensureSpotifyController();
      }
    }

    function powerOnIPod() {
      ipodClassic?.classList.add('is-on');
      ipodOverlay?.classList.remove('is-off');
      ipodOverlay?.classList.add('turning-on');
      ipodPowerLine?.classList.add('animate');

      // Clean up animation classes after they complete
      setTimeout(() => {
        ipodPowerLine?.classList.remove('animate');
      }, 600);
    }

    function getFirstPlayableUri(): string {
      const firstPlayable = currentData?.tracks?.find((track: any) => hasSpotifyUri(track));
      return firstPlayable?.spotify?.spotifyUri || pendingSpotifyUri || DEFAULT_SPOTIFY_URI;
    }

    function ensureSpotifyController() {
      if (!spotifyEmbedHost || spotifyEmbedController) return;

      const mountController = (IFrameAPI: any) => {
        if (!spotifyEmbedHost || spotifyEmbedController) return;

        IFrameAPI.createController(
          spotifyEmbedHost,
          { uri: getFirstPlayableUri(), width: '100%', height: 152 },
          (controller: any) => {
            spotifyEmbedController = controller;

            // Sync playback state from embed (handles card clicks, external pauses, etc.)
            controller.addListener('playback_update', (e: any) => {
              const nowPlaying = !e.data.isPaused;
              if (nowPlaying !== isSpotifyPlaying) {
                isSpotifyPlaying = nowPlaying;
                updatePlayingState();
              }
            });

            if (pendingSpotifyUri) {
              spotifyEmbedController.loadUri?.(pendingSpotifyUri);
              currentLoadedUri = pendingSpotifyUri;
              spotifyEmbedController.play?.();
              isSpotifyPlaying = true;
              pendingSpotifyUri = '';
              updatePlayingState();
            }
          }
        );
      };

      const existingApi = (window as any).SpotifyIframeApi;
      if (existingApi) {
        mountController(existingApi);
        return;
      }

      if (spotifyApiRequested) return;
      spotifyApiRequested = true;

      const previousReady = (window as any).onSpotifyIframeApiReady;
      (window as any).onSpotifyIframeApiReady = (IFrameAPI: any) => {
        if (typeof previousReady === 'function') previousReady(IFrameAPI);
        mountController(IFrameAPI);
      };

      const script = document.createElement('script');
      script.src = 'https://open.spotify.com/embed/iframe-api/v1';
      script.async = true;
      document.body.appendChild(script);
    }

    function playSpotifyUri(uri: string) {
      pendingSpotifyUri = uri;
      ensureSpotifyController();

      if (spotifyEmbedController) {
        // Only reload if it's a different track — avoids restarting from beginning
        if (uri !== currentLoadedUri) {
          spotifyEmbedController.loadUri?.(uri);
          currentLoadedUri = uri;
        }
        spotifyEmbedController.play?.();
        isSpotifyPlaying = true;
        pendingSpotifyUri = '';
        updatePlayingState();
      }
    }

    // --- Auto-submit on paste ---
    urlInput.addEventListener('paste', () => {
      setTimeout(() => {
        const value = urlInput.value.trim();
        if (value && (value.includes('youtube.com') || value.includes('youtu.be'))) {
          form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
        }
      }, 100);
    });

    // --- Extract form ---
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const url = urlInput.value.trim();
      if (!url) return;
      setNotice('');

      showState('loading');
      powerOnIPod();

      try {
        const res = await fetch('/api/tracklist/extract', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url }),
        });

        const data = await res.json();

        if (!res.ok || (data.error && (!data.tracks || data.tracks.length === 0))) {
          if (errorVideoTitle) errorVideoTitle.textContent = data.title || '';
          if (errorMessage) errorMessage.textContent = data.error || 'Something went wrong.';
          if (ipodErrorText) ipodErrorText.textContent = data.error ? 'No tracklist found' : 'Error';
          showState('error');
          return;
        }

        // Initialize tracks without spotify data if not present
        for (const track of data.tracks) {
          if (!track.spotify) {
            track.spotify = { found: false, spotifyUrl: '', spotifyUri: '', albumArt: '', confidence: 'low', score: 0, candidates: [] };
          }
        }

        currentData = data;
        selectedForExport = new Set(data.tracks.map((_: any, index: number) => index));
        playingIndex = null;
        updatePlayerStatus('Playback Ready', 'Select a matched track to play in Spotify.');
        renderIPodPlaylist(data);
        renderDetailTracklist(data);
        showState('results');

        // Run client-side Spotify search if connected
        if (spotifyAccessToken) {
          runClientSpotifySearch(data);
        } else {
          setNotice('Connect Spotify above to match and play tracks.', 'info');
        }

        // Auto-save to library (non-blocking)
        setTimeout(() => {
          saveSet(data, urlInput.value.trim());
          updateLibraryLink();
          if (librarySavedLabel) {
            librarySavedLabel.textContent = 'Saved to My Sets';
            librarySavedLabel.classList.remove('hidden');
          }
          if (data.videoId) {
            history.replaceState(null, '', '#set=' + data.videoId);
          }
        }, 0);
      } catch {
        if (errorVideoTitle) errorVideoTitle.textContent = '';
        if (errorMessage) errorMessage.textContent = 'Something went wrong. Please check your connection and try again.';
        if (ipodErrorText) ipodErrorText.textContent = 'Connection error';
        showState('error');
      }
    });

    // --- Retry / new search ---
    retryBtn?.addEventListener('click', resetToInput);
    newSearchBtn?.addEventListener('click', resetToInput);

    function resetToInput() {
      urlInput.value = '';
      currentData = null;
      selectedIPodIndex = 0;
      playingIndex = null;
      selectedForExport.clear();
      isSpotifyPlaying = false;
      currentLoadedUri = '';
      if (ipodSongList) ipodSongList.innerHTML = '';
      if (tracklist) tracklist.innerHTML = '';
      updatePlayerStatus('Playback Ready', 'Select a matched track to play in Spotify.');
      sessionStorage.removeItem('spotify_code_verifier');
      sessionStorage.removeItem('spotify_oauth_state');
      sessionStorage.removeItem('tracklist_data');
      sessionStorage.removeItem('tracklist_url');
      sessionStorage.removeItem('tracklist_selected');
      clearOAuthStateCookie();
      setNotice('');
      showState('input');
      urlInput.focus();
    }

    // --- iPod screen rendering ---
    function renderIPodPlaylist(data: any) {
      if (!ipodSongList || !ipodSetTitle) return;

      ipodSetTitle.textContent = truncate(data.title || 'Tracklist', 30);
      ipodSongList.innerHTML = '';
      selectedIPodIndex = Math.min(selectedIPodIndex, Math.max(0, data.tracks.length - 1));

      data.tracks.forEach((track: any, index: number) => {
        const li = document.createElement('li');
        const classes = ['ipod-song-item'];
        if (index === selectedIPodIndex) classes.push('selected');
        if (playingIndex === index) classes.push('playing');
        li.className = classes.join(' ');
        li.dataset.index = String(index);
        li.style.animationDelay = `${index * 80}ms`;

        const num = String(index + 1).padStart(2, '0');
        li.innerHTML = `
          <span class="ipod-song-num">${num}</span>
          <span class="ipod-song-name">${escapeHtml(truncate(track.title, 22))}</span>
        `;

        li.addEventListener('click', () => {
          playTrackByIndex(index, 'ipod-list');
        });

        ipodSongList.appendChild(li);
      });

      updateIPodScrollbar();
    }

    function selectIPodSong(index: number) {
      selectedIPodIndex = index;
      ipodSongList?.querySelectorAll('.ipod-song-item').forEach((el, i) => {
        el.classList.toggle('selected', i === index);
      });
      // Scroll the iPod song list to keep selected visible (without moving the page)
      const selected = ipodSongList?.querySelector('.ipod-song-item.selected') as HTMLElement;
      if (selected && ipodSongList) {
        const listRect = ipodSongList.getBoundingClientRect();
        const itemRect = selected.getBoundingClientRect();
        if (itemRect.top < listRect.top) {
          ipodSongList.scrollTop -= (listRect.top - itemRect.top);
        } else if (itemRect.bottom > listRect.bottom) {
          ipodSongList.scrollTop += (itemRect.bottom - listRect.bottom);
        }
      }
      updateIPodScrollbar();
    }

    const PLAY_SVG = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    const PAUSE_SVG = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';

    function updatePlayingState() {
      ipodSongList?.querySelectorAll('.ipod-song-item').forEach((el, i) => {
        el.classList.toggle('playing', playingIndex === i);
      });

      tracklist?.querySelectorAll('.track-row').forEach((el, i) => {
        el.classList.toggle('is-playing', playingIndex === i);
      });

      // Update play/pause icons
      tracklist?.querySelectorAll('.play-btn').forEach((btn, i) => {
        btn.innerHTML = (i === playingIndex && isSpotifyPlaying) ? PAUSE_SVG : PLAY_SVG;
      });
    }

    function updateIPodScrollbar() {
      if (!ipodScrollThumb || !ipodSongList) return;
      const wrapper = ipodSongList.parentElement;
      if (!wrapper) return;

      const ratio = wrapper.clientHeight / ipodSongList.scrollHeight;
      if (ratio >= 1) {
        ipodScrollThumb.style.display = 'none';
        return;
      }
      ipodScrollThumb.style.display = '';
      const thumbH = Math.max(10, ratio * (wrapper.clientHeight - 4));
      const scrollRatio = ipodSongList.scrollTop / (ipodSongList.scrollHeight - wrapper.clientHeight);
      const maxTop = wrapper.clientHeight - 4 - thumbH;
      ipodScrollThumb.style.height = thumbH + 'px';
      ipodScrollThumb.style.top = (scrollRatio * maxTop) + 'px';
    }

    function scrollDetailTrackIntoView(index: number) {
      const item = tracklist?.querySelector(`[data-index="${index}"]`);
      item?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function playTrackByIndex(index: number, source: string) {
      const track = getTrack(index);
      if (!track) return;

      selectIPodSong(index);

      if (!hasSpotifyUri(track)) {
        playingIndex = null;
        updatePlayingState();
        updatePlayerStatus(
          'No Spotify Match',
          `"${track.title}" has no Spotify match.`
        );
        return;
      }

      playingIndex = index;
      updatePlayingState();
      updatePlayerStatus('Now Playing', `${track.title} — ${track.artist}`);
      playSpotifyUri(track.spotify.spotifyUri);
    }

    function toggleSpotifyPlayback() {
      if (!spotifyEmbedController) {
        const selectedTrack = getTrack(selectedIPodIndex);
        if (selectedTrack && hasSpotifyUri(selectedTrack)) {
          playTrackByIndex(selectedIPodIndex, 'ipod-toggle');
        }
        return;
      }

      spotifyEmbedController.togglePlay?.();
      // Optimistically flip state; playback_update listener will correct if needed
      isSpotifyPlaying = !isSpotifyPlaying;
      if (spotifyPlayerStatus) {
        spotifyPlayerStatus.textContent = isSpotifyPlaying ? 'Now Playing' : 'Paused';
      }
      updatePlayingState();
    }

    // --- iPod button interactivity ---
    const ipodBtns = ipodClassic?.querySelectorAll('.ipod-btn');
    const ipodSelectBtn = document.getElementById('ipodSelect');

    if (ipodBtns && ipodBtns.length >= 4) {
      // Previous
      ipodBtns[0].addEventListener('click', () => {
        if (!currentData?.tracks?.length) return;
        const newIdx = Math.max(0, selectedIPodIndex - 1);
        playTrackByIndex(newIdx, 'ipod-prev');
      });

      // Menu — no-op
      ipodBtns[1].addEventListener('click', () => {});

      // Play/Pause
      ipodBtns[2].addEventListener('click', () => {
        toggleSpotifyPlayback();
      });

      // Next
      ipodBtns[3].addEventListener('click', () => {
        if (!currentData?.tracks?.length) return;
        const newIdx = Math.min(currentData.tracks.length - 1, selectedIPodIndex + 1);
        playTrackByIndex(newIdx, 'ipod-next');
      });
    }

    // Center Select button — play selected song
    ipodSelectBtn?.addEventListener('click', () => {
      if (!currentData?.tracks?.length) return;
      playTrackByIndex(selectedIPodIndex, 'ipod-center');
    });

    // Mouse wheel on iPod — slower, thresholded navigation
    ipodClassic?.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (!currentData?.tracks?.length) return;

      const we = e as WheelEvent;
      wheelDeltaAccumulator += we.deltaY;

      const now = Date.now();
      if (now - lastWheelMoveAt < WHEEL_COOLDOWN_MS) return;
      if (Math.abs(wheelDeltaAccumulator) < WHEEL_THRESHOLD) return;

      const direction = wheelDeltaAccumulator > 0 ? 1 : -1;
      wheelDeltaAccumulator = 0;
      lastWheelMoveAt = now;

      const newIdx = Math.max(0, Math.min(currentData.tracks.length - 1, selectedIPodIndex + direction));
      if (newIdx !== selectedIPodIndex) {
        selectIPodSong(newIdx);
      }
    }, { passive: false });

    // --- Detail tracklist rendering ---
    function renderDetailTracklist(data: any) {
      if (setTitle) setTitle.textContent = data.title || 'DJ Set';
      if (channelName) channelName.textContent = data.channelName || '';
