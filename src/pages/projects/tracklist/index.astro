    function handleTracklistClick(e: Event) {
      const target = e.target as HTMLElement;

      const playBtn = target.closest('.play-btn') as HTMLElement | null;
      if (playBtn) {
        const idx = parseInt(playBtn.dataset.trackIdx || '-1', 10);
        if (idx >= 0) {
          if (idx === playingIndex) {
            toggleSpotifyPlayback();
          } else {
            playTrackByIndex(idx, 'row-play');
          }
        }
        return;
      }
    }

    function handleTracklistDoubleClick(e: Event) {
      const target = e.target as HTMLElement;
      if (
        target.closest('.track-actions-cell') ||
        target.closest('input,button,a,label')
      ) {
        return;
      }

      const row = target.closest('.track-row') as HTMLElement | null;
      if (!row) return;

      const idx = parseInt(row.dataset.index || '-1', 10);
      if (idx >= 0) playTrackByIndex(idx, 'row-double-click');
    }

    function handleTracklistChange(e: Event) {
      const target = e.target as HTMLInputElement;
      if (!target.classList.contains('track-select')) return;

      const idx = parseInt(target.dataset.index || '-1', 10);
      if (idx < 0) return;

      if (target.checked) {
        selectedForExport.add(idx);
      } else {
        selectedForExport.delete(idx);
      }
      updateExportCount();
    }

    function handleSelectAllChange() {
      if (!currentData?.tracks?.length) return;

      selectedForExport.clear();
      if (selectAllEl.checked) {
        currentData.tracks.forEach((_: any, index: number) => {
          selectedForExport.add(index);
        });
      }

      tracklist?.querySelectorAll('.track-select').forEach((cb) => {
        (cb as HTMLInputElement).checked = selectAllEl.checked;
      });
      updateExportCount();
    }

    tracklist.addEventListener('click', handleTracklistClick);
    tracklist.addEventListener('dblclick', handleTracklistDoubleClick);
    tracklist.addEventListener('change', handleTracklistChange);
    selectAllEl.addEventListener('change', handleSelectAllChange);

    // --- Spotify PKCE ---
    const SPOTIFY_CLIENT_ID = (window as any).__SPOTIFY_CLIENT_ID || '';
    const REDIRECT_URI = `${window.location.origin}/projects/tracklist`;
    console.log('[tracklist] SPOTIFY_CLIENT_ID:', SPOTIFY_CLIENT_ID ? SPOTIFY_CLIENT_ID.slice(0, 4) + '...' : '(empty)');

    function updateSpotifyConnectUI() {
      if (!spotifyConnectBtn || !spotifyConnectStatus) return;
      if (spotifyAccessToken) {
        spotifyConnectBtn.classList.add('is-connected');
        spotifyConnectBtn.textContent = 'Spotify Connected';
        spotifyConnectStatus.textContent = '';
      } else {
        spotifyConnectBtn.classList.remove('is-connected');
        spotifyConnectBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg> Connect Spotify`;
        spotifyConnectStatus.textContent = 'for track matching';
      }
    }

    updateSpotifyConnectUI();

    async function startSpotifyConnect() {
      console.log('[tracklist] Connect Spotify clicked');
      if (!SPOTIFY_CLIENT_ID) {
        console.error('[tracklist] PUBLIC_SPOTIFY_CLIENT_ID not set — button disabled');
        setNotice('Spotify is not configured. Please contact the site owner.', 'error');
        if (spotifyConnectBtn) {
          spotifyConnectBtn.style.borderColor = '#c75050';
          spotifyConnectBtn.style.color = '#c75050';
        }
        return;
      }

      // Save current URL input so we can restore after redirect
      sessionStorage.setItem('tracklist_url', urlInput.value);
      sessionStorage.setItem('spotify_connect_flow', 'true');

      const codeVerifier = generateRandomString(128);
      const oauthState = generateRandomString(32);
      sessionStorage.setItem('spotify_code_verifier', codeVerifier);
      sessionStorage.setItem('spotify_oauth_state', oauthState);
      setOAuthStateCookie(oauthState);
      const codeChallenge = await sha256Base64url(codeVerifier);

      const params = new URLSearchParams({
        client_id: SPOTIFY_CLIENT_ID,
        response_type: 'code',
        redirect_uri: REDIRECT_URI,
        scope: 'playlist-modify-public playlist-modify-private user-read-private user-library-modify',
        code_challenge_method: 'S256',
        code_challenge: codeChallenge,
        state: oauthState,
      });
      window.location.href = `https://accounts.spotify.com/authorize?${params.toString()}`;
    }

    spotifyConnectBtn?.addEventListener('click', () => {
      if (spotifyAccessToken) return; // Already connected
      startSpotifyConnect();
    });

    async function handleSpotifyConnectCallback(): Promise<boolean> {
      const params = new URLSearchParams(window.location.search);
      const code = params.get('code');
      const state = params.get('state');
      const isConnectFlow = sessionStorage.getItem('spotify_connect_flow') === 'true';

      if (!code || !isConnectFlow) return false;

      sessionStorage.removeItem('spotify_connect_flow');
      history.replaceState({}, '', window.location.pathname);

      const expectedState = sessionStorage.getItem('spotify_oauth_state');
      if (!state || !expectedState || state !== expectedState) {
        clearSpotifyOAuthSession();
        setNotice('Spotify session validation failed. Please try connecting again.', 'error');
        return true;
      }

      const codeVerifier = sessionStorage.getItem('spotify_code_verifier');
      if (!codeVerifier) {
        clearSpotifyOAuthSession();
        setNotice('Session expired. Please try connecting again.', 'error');
        return true;
      }

      // Exchange code for token via Spotify directly (PKCE doesn't need client secret)
      try {
        const tokenRes = await fetch('https://accounts.spotify.com/api/token', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            grant_type: 'authorization_code',
            code,
            redirect_uri: REDIRECT_URI,
            client_id: SPOTIFY_CLIENT_ID,
            code_verifier: codeVerifier,
          }),
        });

        if (!tokenRes.ok) {
          throw new Error('Token exchange failed');
        }

        const tokenData = await tokenRes.json();
        spotifyAccessToken = tokenData.access_token;
        sessionStorage.setItem('spotify_access_token', spotifyAccessToken!);

        // Store refresh token for future use
        if (tokenData.refresh_token) {
          sessionStorage.setItem('spotify_refresh_token', tokenData.refresh_token);
        }

        updateSpotifyConnectUI();
        setNotice('Spotify connected! Paste a YouTube URL to extract and match tracks.', 'success');
      } catch {
        setNotice('Failed to connect to Spotify. Please try again.', 'error');
      }

      clearSpotifyOAuthSession();

      // Restore URL input
      const savedUrl = sessionStorage.getItem('tracklist_url');
      if (savedUrl) urlInput.value = savedUrl;

      return true;
    }

    // --- Client-side Spotify search after extraction ---

    async function runClientSpotifySearch(data: any) {
      if (!spotifyAccessToken || !data?.tracks?.length) return;

      if (spotifyConnectStatus) {
        spotifyConnectStatus.textContent = 'Matching tracks...';
      }

      await searchAllTracks(
        data.tracks,
        spotifyAccessToken,
        (index: number, match: SpotifyMatch) => {
          // Update the track data in place
          if (data.tracks[index]) {
            data.tracks[index].spotify = match;
          }

          // Update the detail tracklist row
          const row = tracklist?.querySelector(`[data-index="${index}"]`) as HTMLElement | null;
          if (row) {
            updateTrackRow(row, data.tracks[index], index);
          }

          // Update selection metrics
          updateExportCount();

          // Update connect status with progress
          if (spotifyConnectStatus) {
            const matched = data.tracks.filter((t: any) => t.spotify?.found).length;
            spotifyConnectStatus.textContent = `Matched ${matched} of ${data.tracks.length}`;
          }
        }
      );

      // Final update
      if (spotifyConnectStatus) {
        const matched = data.tracks.filter((t: any) => t.spotify?.found).length;
        spotifyConnectStatus.textContent = `${matched} matched`;
      }

      // Re-save to library with match data
      saveSet(data, urlInput.value.trim());
    }

    function updateTrackRow(row: HTMLElement, track: any, index: number) {
      // Update confidence badge
      const badge = row.querySelector('.confidence-badge');
      if (badge) {
        const confidenceClass = track.spotify?.found ? `confidence-${track.spotify.confidence}` : 'confidence-none';
        const confidenceLabel = track.spotify?.found
          ? (track.spotify.confidence === 'high' ? 'Matched' : track.spotify.confidence === 'medium' ? 'Possible' : 'No match')
          : 'No match';
        badge.className = `confidence-badge ${confidenceClass}`;
        badge.textContent = confidenceLabel;
      }

      // Update row classes
      row.classList.toggle('no-match', !track.spotify?.found);
      row.classList.toggle('low-confidence', track.spotify?.found && track.spotify.confidence === 'low');

      // Update Spotify link
      const spotifyLink = row.querySelector('.spotify-link-btn');
      if (spotifyLink && track.spotify?.found && track.spotify.spotifyUrl) {
        const a = document.createElement('a');
        a.href = track.spotify.spotifyUrl;
        a.target = '_blank';
        a.rel = 'noopener';
        a.className = 'track-icon-btn spotify-link-btn';
        a.setAttribute('aria-label', 'Open on Spotify');
        a.title = 'Open on Spotify';
        a.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>`;
        spotifyLink.replaceWith(a);
      }
    }

    exportSpotifyBtn?.addEventListener('click', startSpotifyExport);

    function clearSpotifyOAuthSession() {
      sessionStorage.removeItem('spotify_code_verifier');
      sessionStorage.removeItem('spotify_oauth_state');
      clearOAuthStateCookie();
    }

    function clearTracklistSession() {
      sessionStorage.removeItem('tracklist_data');
      sessionStorage.removeItem('tracklist_url');
      sessionStorage.removeItem('tracklist_selected');
    }

    function getApiErrorMessage(payload: unknown, fallback: string): string {
      if (!payload || typeof payload !== 'object') return fallback;
      const body = payload as Record<string, unknown>;
      if (typeof body.error === 'string' && body.error.trim()) return body.error;
      if (typeof body.message === 'string' && body.message.trim()) return body.message;
      const details = body.errorDetails;
      if (details && typeof details === 'object') {
        const detailMessage = (details as Record<string, unknown>).message;
        if (typeof detailMessage === 'string' && detailMessage.trim()) {
          return detailMessage;
        }
      }
      return fallback;
    }

    async function parseResponseJson(response: Response): Promise<Record<string, unknown>> {
      try {
        const payload = await response.json();
        if (payload && typeof payload === 'object') {
          return payload as Record<string, unknown>;
        }
      } catch {
        // Ignore JSON parsing errors and return a generic object
      }
      return {};
    }

    // --- Export celebration ---

    function fireConfetti() {
      const canvas = document.getElementById('confettiCanvas') as HTMLCanvasElement | null;
      if (!canvas) return;
      const stage = canvas.parentElement;
      if (!stage) return;

      const rect = stage.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const colors = ['#1DB954', '#2D5F3F', '#F4D35E', '#EE964B', '#5B8FB9', '#C75050'];
      const particles: Array<{
        x: number; y: number; vx: number; vy: number;
        w: number; h: number; color: string; rotation: number;
        rotationSpeed: number; gravity: number; opacity: number;
      }> = [];

      const cx = rect.width / 2;
      const cy = rect.height * 0.3;

      for (let i = 0; i < 80; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 2 + Math.random() * 6;
        particles.push({
          x: cx + (Math.random() - 0.5) * 60,
          y: cy + (Math.random() - 0.5) * 20,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 3,
          w: 4 + Math.random() * 6,
          h: 3 + Math.random() * 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * 360,
          rotationSpeed: (Math.random() - 0.5) * 12,
          gravity: 0.12 + Math.random() * 0.08,
          opacity: 1,
        });
      }

      let frame = 0;
      const maxFrames = 120;

      function animate() {
        if (frame >= maxFrames) {
          ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
          return;
        }
        ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += p.gravity;
          p.vx *= 0.99;
          p.rotation += p.rotationSpeed;
          p.opacity = Math.max(0, 1 - frame / maxFrames);
          ctx!.save();
          ctx!.translate(p.x, p.y);
          ctx!.rotate((p.rotation * Math.PI) / 180);
          ctx!.globalAlpha = p.opacity;
          ctx!.fillStyle = p.color;
          ctx!.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx!.restore();
        }
        frame++;
        requestAnimationFrame(animate);
      }
      requestAnimationFrame(animate);
    }

    function celebrateExport() {
      if (!exportSpotifyBtn) return;

      const originalHTML = exportSpotifyBtn.innerHTML;
      exportSpotifyBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg> Success!`;
      exportSpotifyBtn.classList.add('is-success');

      fireConfetti();

      setTimeout(() => {
        exportSpotifyBtn.innerHTML = originalHTML;
        exportSpotifyBtn.classList.remove('is-success');
        newSearchBtn?.classList.add('is-highlighted');
        setTimeout(() => newSearchBtn?.classList.remove('is-highlighted'), 2000);
      }, 3000);
    }

    async function startSpotifyExport() {
      setNotice('');
      if (!SPOTIFY_CLIENT_ID) {
        setNotice('Spotify export is not configured in this beta environment yet.', 'error');
        return;
      }
      const { readyCount } = getSelectionMetrics();
      if (!currentData?.tracks?.length || readyCount === 0) {
        setNotice('Select at least one matched track before exporting.', 'error');
        return;
      }

      sessionStorage.setItem('tracklist_data', JSON.stringify(currentData));
      sessionStorage.setItem('tracklist_url', urlInput.value);
      sessionStorage.setItem('tracklist_selected', JSON.stringify([...selectedForExport]));

      const codeVerifier = generateRandomString(128);
      const oauthState = generateRandomString(32);
      sessionStorage.setItem('spotify_code_verifier', codeVerifier);
      sessionStorage.setItem('spotify_oauth_state', oauthState);
      setOAuthStateCookie(oauthState);
      const codeChallenge = await sha256Base64url(codeVerifier);

      const params = new URLSearchParams({
        client_id: SPOTIFY_CLIENT_ID, response_type: 'code',
        redirect_uri: REDIRECT_URI, scope: 'playlist-modify-public playlist-modify-private user-read-private user-library-modify',
        code_challenge_method: 'S256', code_challenge: codeChallenge,
        state: oauthState,
      });
      window.location.href = `https://accounts.spotify.com/authorize?${params.toString()}`;
    }

    async function handleSpotifyCallback() {
      const params = new URLSearchParams(window.location.search);
      const code = params.get('code');
      const error = params.get('error');
      const state = params.get('state');

      if (error) {
        history.replaceState({}, '', window.location.pathname);
        clearSpotifyOAuthSession();
        setNotice('Spotify login was cancelled.', 'error');
        if (errorMessage) errorMessage.textContent = 'Spotify login was cancelled.';
        if (ipodErrorText) ipodErrorText.textContent = 'Login cancelled';
        powerOnIPod();
        showState('error');
        return;
      }

      if (!code) return;
      history.replaceState({}, '', window.location.pathname);

      const expectedState = sessionStorage.getItem('spotify_oauth_state');
      if (!state || !expectedState || state !== expectedState) {
        clearSpotifyOAuthSession();
        setNotice('Spotify session validation failed. Please try exporting again.', 'error');
        if (errorMessage) errorMessage.textContent = 'Session expired. Please extract the tracklist again.';
        showState('input');
        return;
      }

      const codeVerifier = sessionStorage.getItem('spotify_code_verifier');
      const savedData = sessionStorage.getItem('tracklist_data');
      const savedUrl = sessionStorage.getItem('tracklist_url');

      if (!codeVerifier || !savedData) {
        clearSpotifyOAuthSession();
        if (errorMessage) errorMessage.textContent = 'Session expired. Please extract the tracklist again.';
        setNotice('Session expired. Please extract the tracklist again.', 'error');
        showState('input');
        return;
      }

      currentData = JSON.parse(savedData);
      if (savedUrl) urlInput.value = savedUrl;
      const savedSelected = sessionStorage.getItem('tracklist_selected');
      if (savedSelected) {
        selectedForExport = new Set(JSON.parse(savedSelected).map((idx: unknown) => Number(idx)).filter((idx: number) => Number.isInteger(idx)));
      } else {
        selectedForExport = new Set(currentData.tracks.map((_: any, i: number) => i));
      }

      // Skip atmosphere, show iPod directly with loading
      powerOnIPod();
      if (ipodLoadingText) ipodLoadingText.textContent = 'Creating playlist...';
      showState('loading');

      try {
        // Build track URIs list
        const uris = currentData.tracks
          .filter((t: any, i: number) => selectedForExport.has(i) && t.spotify?.found && t.spotify.spotifyUri)
          .map((t: any) => t.spotify.spotifyUri);
        const selectedCount = selectedForExport.size;
        const unresolvedCount = Math.max(0, selectedCount - uris.length);

        // Send to server-side API (avoids browser CORS/permission issues with Spotify)
        const exportRes = await fetch('/api/tracklist/export', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            code,
            codeVerifier,
            state,
            playlistName: currentData.title || 'DJ Set Tracklist',
            playlistDescription: currentData.source === 'comment' && currentData.commentAuthor
              ? `Tracklist by ${currentData.commentAuthor} on "${currentData.title}". Created with lacerda.cl/projects/tracklist`
              : `Tracklist extracted from "${currentData.title}" by ${currentData.channelName}. Created with lacerda.cl/projects/tracklist`,
            uris,
          }),
        });

        const result = await parseResponseJson(exportRes);

        if (!exportRes.ok) {
          throw new Error(getApiErrorMessage(result, 'Export failed'));
        }

        const addedCount = typeof result.addedCount === 'number' ? result.addedCount : 0;
        const failedCount = typeof result.failedCount === 'number' ? result.failedCount : 0;
        const likedCount = typeof result.likedCount === 'number' ? result.likedCount : 0;
        const playlistUrl = typeof result.playlistUrl === 'string' ? result.playlistUrl : '#';

        // Mark exported tracks
        currentData.tracks.forEach((_: any, i: number) => {
          if (selectedForExport.has(i) && currentData.tracks[i].spotify?.found && currentData.tracks[i].spotify.spotifyUri) {
            exportedTracks.add(i);
          }
        });

        // Re-render with exported badges
        renderIPodPlaylist(currentData);
        renderDetailTracklist(currentData);
        showState('results');

        // Show inline export status (replaces selection pill)
        if (exportSelectionPill) exportSelectionPill.classList.add('hidden');
        const parts = [`${addedCount} track${addedCount !== 1 ? 's' : ''} added`];
        if (likedCount > 0) parts.push('saved to Liked Songs');
        if (failedCount > 0) parts.push(`${failedCount} failed`);
        if (unresolvedCount > 0) parts.push(`${unresolvedCount} skipped`);
        const summary = parts.join(' · ');
        if (exportStatusMessage) exportStatusMessage.textContent = summary;
        if (exportPlaylistLink && playlistUrl !== '#') {
          exportPlaylistLink.href = playlistUrl;
          exportPlaylistLink.style.display = '';
        } else if (exportPlaylistLink) {
          exportPlaylistLink.style.display = 'none';
        }
        exportStatusInline?.classList.remove('hidden');

        // Inline celebration
        celebrateExport();

        // Save export to library
        if (currentData?.videoId) {
          const uris = currentData.tracks
            .filter((_: any, i: number) => selectedForExport.has(i) && currentData.tracks[i].spotify?.spotifyUri)
            .map((t: any) => t.spotify.spotifyUri);
          updateSetExport(currentData.videoId, {
            exportedAt: new Date().toISOString(),
            playlistUrl,
            addedCount,
            likedCount,
            failedCount,
            exportedUris: uris,
          });
        }

        clearSpotifyOAuthSession();
        clearTracklistSession();
      } catch (err) {
        console.error('Spotify export error:', err);
        clearSpotifyOAuthSession();
        renderIPodPlaylist(currentData);
        renderDetailTracklist(currentData);
        showState('results');
        const msg = err instanceof Error ? err.message : 'Failed to create playlist. Please try again.';
        setNotice(msg, 'error');
      }
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function escapeAttr(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function truncate(str: string, len: number): string {
      return str.length > len ? str.slice(0, len) + '…' : str;
    }

    // --- My Sets Library ---

    function updateLibraryLink() {
      const count = getLibraryCount();
      if (libraryLink) {
        libraryLink.classList.toggle('hidden', count === 0);
      }
      if (libraryCountBadge) libraryCountBadge.textContent = String(count);
      if (resultsLibraryBtn) {
        resultsLibraryBtn.classList.toggle('hidden', count === 0);
      }
      if (resultsLibraryCount) resultsLibraryCount.textContent = String(count);
    }

    function formatLibraryDate(iso: string): string {
      try {
        const d = new Date(iso);
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      } catch {
        return '';
      }
    }

    function renderLibraryList(filterQuery?: string) {
      if (!libraryList || !libraryEmpty) return;

      const sets = filterQuery ? searchLibrary(filterQuery) : loadLibrary();

      if (sets.length === 0) {
        libraryList.innerHTML = '';
        libraryEmpty.classList.remove('hidden');
        return;
      }

      libraryEmpty.classList.add('hidden');

      libraryList.innerHTML = sets.map((set) => {
        const matchedCount = set.tracks.filter((t) => t.spotify.found).length;
        const hasExport = set.exportHistory.length > 0;
        const thumbSrc = set.thumbnailUrl ? escapeAttr(set.thumbnailUrl) : '';

        return `<div class="library-row" data-video-id="${escapeAttr(set.videoId)}">
          ${thumbSrc ? `<img class="library-row-thumb" src="${thumbSrc}" alt="" loading="lazy" />` : '<div class="library-row-thumb"></div>'}
          <div class="library-row-info">
            <p class="library-row-title">${escapeAttr(truncate(set.title, 60))}</p>
            <div class="library-row-meta">
              <span class="library-row-channel">${escapeAttr(set.channelName)}</span>
              <span>${set.tracks.length} tracks${matchedCount > 0 ? ` · ${matchedCount} matched` : ''}</span>
              <span>${formatLibraryDate(set.extractedAt)}</span>
              ${hasExport ? '<span class="library-exported-badge">Exported</span>' : ''}
            </div>
          </div>
          <button class="library-delete-btn" data-delete-id="${escapeAttr(set.videoId)}" title="Delete set" aria-label="Delete ${escapeAttr(set.title)}">×</button>
        </div>`;
      }).join('');

      // Event delegation for row clicks and delete buttons
      libraryList.onclick = (e: MouseEvent) => {
        const target = e.target as HTMLElement;

        // Delete button
        const deleteBtn = target.closest('.library-delete-btn') as HTMLElement | null;
        if (deleteBtn) {
          e.stopPropagation();
          const videoId = deleteBtn.dataset.deleteId;
          if (videoId && confirm('Delete this set from your library?')) {
            deleteSet(videoId);
            updateLibraryLink();
            renderLibraryList(librarySearch?.value || undefined);
          }
          return;
        }

        // Row click
        const row = target.closest('.library-row') as HTMLElement | null;
        if (row?.dataset.videoId) {
          openSavedSet(row.dataset.videoId);
        }
      };
    }

    function openSavedSet(videoId: string) {
      const set = loadSet(videoId);
      if (!set) return;

      currentData = toTracklistData(set);
      selectedForExport = new Set(currentData.tracks.map((_: any, i: number) => i));
      playingIndex = null;

      // Restore per-track exported state from export history
      exportedTracks.clear();
      const exportedUris = getExportedUrisForSet(set);
      if (exportedUris.size > 0) {
        currentData.tracks.forEach((t: any, i: number) => {
          if (t.spotify?.spotifyUri && exportedUris.has(t.spotify.spotifyUri)) {
            exportedTracks.add(i);
          }
        });
      }

      updatePlayerStatus('Playback Ready', 'Select a matched track to play in Spotify.');
      powerOnIPod();
      renderIPodPlaylist(currentData);
      renderDetailTracklist(currentData);
      showState('results');

      // Show export status if previously exported
      if (set.exportHistory.length > 0) {
        const latest = set.exportHistory[set.exportHistory.length - 1];
        if (exportSelectionPill) exportSelectionPill.classList.add('hidden');
        const parts = [`${latest.addedCount} track${latest.addedCount !== 1 ? 's' : ''} added`];
        if (latest.likedCount > 0) parts.push('saved to Liked Songs');
        if (exportStatusMessage) exportStatusMessage.textContent = parts.join(' · ');
        if (exportPlaylistLink && latest.playlistUrl !== '#') {
          exportPlaylistLink.href = latest.playlistUrl;
          exportPlaylistLink.style.display = '';
        } else if (exportPlaylistLink) {
          exportPlaylistLink.style.display = 'none';
        }
        exportStatusInline?.classList.remove('hidden');
      }

      urlInput.value = set.videoUrl || '';

      // Show "Loaded from My Sets" label
      if (librarySavedLabel) {
        librarySavedLabel.textContent = 'Loaded from My Sets';
        librarySavedLabel.classList.remove('hidden');
      }

      history.replaceState(null, '', '#set=' + videoId);
    }

    // Library search with debounce
    let librarySearchTimer: ReturnType<typeof setTimeout> | null = null;
    librarySearch?.addEventListener('input', () => {
      if (librarySearchTimer) clearTimeout(librarySearchTimer);
      librarySearchTimer = setTimeout(() => {
        renderLibraryList(librarySearch.value || undefined);
      }, 200);
    });

    // Library button clicks
    openLibraryBtn?.addEventListener('click', () => showState('library'));
    resultsLibraryBtn?.addEventListener('click', () => showState('library'));

    // Hash-based navigation
    function handleHashState(): boolean {
      const hash = location.hash;
      // Skip if OAuth callback is in progress
      if (location.search.includes('code=')) return false;

      if (hash === '#library' && getLibraryCount() > 0) {
        showState('library');
        return true;
      }

      if (hash.startsWith('#set=')) {
        const videoId = hash.slice(5);
        if (videoId && loadSet(videoId)) {
          openSavedSet(videoId);
          return true;
        }
      }

      return false;
    }

    window.addEventListener('hashchange', () => {
      handleHashState();
    });

    // --- Init ---
    const urlHadCode = location.search.includes('code=');

    // Handle Spotify connect callback first (returns true if it was a connect flow)
    const wasConnectCallback = await handleSpotifyConnectCallback();

    if (!wasConnectCallback) {
      // Handle export callback (existing flow)
      await handleSpotifyCallback();
    }

    // If no OAuth callback was handled, check hash state or default to library
    if (!urlHadCode) {
      if (!handleHashState()) {
        // Default to library on return visits if sets exist
        if (getLibraryCount() > 0) {
          showState('library');
        } else {
          updateLibraryLink();
        }
      }
    }
  }

  initTracklist();
  document.addEventListener('astro:after-swap', initTracklist);
</script>

