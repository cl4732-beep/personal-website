    font-size: var(--text-sm);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .tracklist-page .spotify-connect-btn:hover {
    background: #1DB954;
    color: #fff;
  }

  .tracklist-page .spotify-connect-btn.is-connected {
    background: #1DB954;
    color: #fff;
    cursor: default;
    border-color: #1DB954;
  }

  .tracklist-page .spotify-connect-status {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* ========================================
     iPod Stage
     ======================================== */
  .tracklist-page .ipod-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--space-2xl);
    opacity: 0;
    transform: translateY(24px);
    animation: ipodStageEnter 0.6s ease 0.2s forwards;
  }

  .tracklist-page .ipod-stage.hidden {
    display: none;
    opacity: 0;
    animation: none;
  }

  /* Side-by-side layout */
  .tracklist-page .ipod-and-list {
    display: flex;
    gap: var(--space-2xl);
    align-items: flex-start;
    width: 100%;
  }

  .tracklist-page .ipod-column {
    flex-shrink: 0;
  }

  @keyframes ipodStageEnter {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ========================================
     iPod Classic — CSS Art
     ======================================== */
  .tracklist-page .ipod-classic {
    --ipod-w: 240px;
    --ipod-screen-bg: #9BA87C;
    --ipod-screen-lit: #B8C99A;
    --ipod-screen-text: #2C3320;
    --ipod-white: #E8E6E0;
    --ipod-white-hi: #F5F3EF;
    --ipod-white-sh: #CBC8C0;
    --ipod-chrome: #C8C8C8;
    --ipod-chrome-hi: #E0E0E0;
    --ipod-chrome-sh: #999;
    position: relative;
  }

  .tracklist-page .ipod-chrome-edge {
    position: absolute;
    top: -2px;
    left: -2px;
    width: calc(var(--ipod-w) + 4px);
    height: calc(var(--ipod-w) * 1.72 + 4px);
    border-radius: 20px;
    background: linear-gradient(145deg, var(--ipod-chrome-hi) 0%, var(--ipod-chrome) 50%, var(--ipod-chrome-sh) 100%);
    z-index: -1;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
  }

  .tracklist-page .ipod-body {
    width: var(--ipod-w);
    height: calc(var(--ipod-w) * 1.72);
    background: linear-gradient(180deg, var(--ipod-white-hi) 0%, var(--ipod-white) 5%, var(--ipod-white) 90%, var(--ipod-white-sh) 100%);
    border-radius: 18px;
    padding: 20px 18px 16px;
    box-shadow:
      0 10px 40px rgba(0,0,0,0.18),
      0 2px 8px rgba(0,0,0,0.08),
      inset 0 1px 0 rgba(255,255,255,0.6),
      inset -1px 0 3px rgba(0,0,0,0.02),
      inset 1px 0 3px rgba(0,0,0,0.02);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* --- Screen --- */
  .tracklist-page .ipod-screen-housing {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 10px;
  }

  .tracklist-page .ipod-label {
    font-family: -apple-system, 'Helvetica Neue', sans-serif;
    font-size: 10px;
    font-weight: 300;
    color: #aaa;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .tracklist-page .ipod-screen {
    width: 100%;
    aspect-ratio: 160 / 128;
    background: var(--ipod-screen-bg);
    border-radius: 3px;
    overflow: hidden;
    position: relative;
    box-shadow: inset 0 1px 4px rgba(0,0,0,0.25), 0 1px 0 rgba(255,255,255,0.3);
  }

  .tracklist-page .ipod-classic.is-on .ipod-screen {
    background: var(--ipod-screen-lit);
  }

  /* Screen overlay (off / power-on) */
  .tracklist-page .ipod-screen-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    background: var(--ipod-screen-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.4s ease 0.3s;
  }

  .tracklist-page .ipod-screen-overlay.turning-on {
    opacity: 0;
    pointer-events: none;
  }

  .tracklist-page .ipod-screen-overlay.is-off {
    opacity: 1;
    pointer-events: auto;
    transition: none;
  }

  .tracklist-page .ipod-power-line {
    width: 0;
    height: 1px;
    background: var(--ipod-screen-text);
    opacity: 0;
  }

  .tracklist-page .ipod-power-line.animate {
    animation: lcdPowerOn 0.5s ease-out forwards;
  }

  @keyframes lcdPowerOn {
    0% { width: 0; height: 1px; opacity: 1; }
    50% { width: 60%; height: 1px; opacity: 1; }
    80% { width: 100%; height: 100%; opacity: 0.3; }
    100% { width: 100%; height: 100%; opacity: 0; }
  }

  /* LCD glow */
  .tracklist-page .ipod-lcd-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(184,201,154,0.35) 0%, rgba(184,201,154,0.08) 70%, transparent 100%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 1;
  }

  .tracklist-page .ipod-classic.is-on .ipod-lcd-glow { opacity: 1; }

  /* Screen content */
  .tracklist-page .ipod-screen-content {
    position: absolute;
    inset: 0;
    z-index: 5;
    padding: 4px 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.4;
    color: var(--ipod-screen-text);
    -webkit-font-smoothing: none;
    overflow: hidden;
  }

  /* Loading */
  .tracklist-page .ipod-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 6px;
  }

  .tracklist-page .ipod-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(44,51,32,0.2);
    border-top-color: var(--ipod-screen-text);
    border-radius: 50%;
    animation: ipodSpin 0.8s linear infinite;
  }

  @keyframes ipodSpin {
    to { transform: rotate(360deg); }
  }

  .tracklist-page .ipod-loading-text {
    font-size: 8px;
    opacity: 0.8;
  }

  /* Playlist */
  .tracklist-page .ipod-header-bar {
    border-bottom: 1px solid var(--ipod-screen-text);
    padding-bottom: 2px;
    margin-bottom: 2px;
    font-weight: 700;
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tracklist-page .ipod-playlist {
    height: 100%;
  }

  .tracklist-page .ipod-song-list-wrapper {
    position: relative;
    overflow: hidden;
    height: calc(100% - 18px);
  }

  .tracklist-page .ipod-song-list {
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-y: auto;
    height: 100%;
    scrollbar-width: none;
  }

  .tracklist-page .ipod-song-list::-webkit-scrollbar { display: none; }

  .tracklist-page .ipod-song-item {
    display: flex;
    gap: 4px;
    padding: 1px 3px;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
    opacity: 0;
    animation: ipodSongAppear 200ms ease forwards;
  }

  @keyframes ipodSongAppear {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tracklist-page .ipod-song-item.selected {
    background: rgba(44,51,32,0.1);
    color: var(--ipod-screen-text);
  }

  .tracklist-page .ipod-song-item.playing {
    background: var(--ipod-screen-text);
    color: var(--ipod-screen-lit);
  }

  .tracklist-page .ipod-song-item:hover:not(.playing) {
    background: rgba(44,51,32,0.16);
  }

  .tracklist-page .ipod-song-num {
    flex-shrink: 0;
    width: 16px;
    text-align: right;
    opacity: 0.6;
  }

  .tracklist-page .ipod-song-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Scrollbar */
  .tracklist-page .ipod-scrollbar {
    position: absolute;
    right: 1px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: rgba(44,51,32,0.1);
    border-radius: 1.5px;
  }

  .tracklist-page .ipod-scrollbar-thumb {
    width: 100%;
    background: var(--ipod-screen-text);
    border-radius: 1.5px;
    position: absolute;
    top: 0;
    min-height: 8px;
    opacity: 0.4;
  }

  /* Error on screen */
  .tracklist-page .ipod-error, .tracklist-page .ipod-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 4px;
    text-align: center;
  }

  .tracklist-page .ipod-error-icon {
    font-size: 14px;
    font-weight: 700;
  }

  .tracklist-page .ipod-error-text, .tracklist-page .ipod-success-text {
    font-size: 8px;
  }

  .tracklist-page .ipod-success-icon {
    font-size: 16px;
  }

  /* --- Controls --- */
  .tracklist-page .ipod-control-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 1;
    justify-content: center;
    width: 100%;
  }

  .tracklist-page .ipod-button-row {
    display: flex;
    justify-content: center;
    gap: 4px;
  }

  .tracklist-page .ipod-btn {
    width: 42px;
    height: 16px;
    border-radius: 3px;
    border: none;
    background: linear-gradient(to bottom, #D4D0C8, #C0BCB4);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 0 1px 2px rgba(0,0,0,0.08);
    font-size: 6px;
    color: #888;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
    letter-spacing: 0.04em;
    font-family: -apple-system, sans-serif;
  }

  .tracklist-page .ipod-wheel {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(145deg, #D4D0C8, #B8B4AC);
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.12), 0 1px 0 rgba(255,255,255,0.4), 0 4px 12px rgba(0,0,0,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .tracklist-page .ipod-wheel::before {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.04);
  }

  .tracklist-page .ipod-wheel::after {
    content: '';
    position: absolute;
    inset: 18px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.03);
  }

  .tracklist-page .ipod-select {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(145deg, var(--ipod-white-hi), var(--ipod-white-sh));
    box-shadow: 0 2px 6px rgba(0,0,0,0.1), inset 0 1px 0 rgba(255,255,255,0.5);
    cursor: default;
    z-index: 1;
  }

  .tracklist-page .ipod-classic.is-on .ipod-btn,
  .tracklist-page .ipod-classic.is-on .ipod-select {
    cursor: pointer;
  }

  .tracklist-page .ipod-classic.is-on .ipod-btn:active {
    background: linear-gradient(to bottom, #C0BCB4, #B0ACA4);
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.12);
  }

  .tracklist-page .ipod-classic.is-on .ipod-select:active {
    background: linear-gradient(145deg, var(--ipod-white-sh), var(--ipod-white-hi));
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.12);
  }

  /* ========================================
     Spotify Player
     ======================================== */
  .tracklist-page .spotify-player-card {
    margin-top: var(--space-md);
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background-color: var(--color-surface);
    width: min(100%, 270px);
  }

  .tracklist-page .spotify-player-status {
    margin-bottom: 2px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .tracklist-page .spotify-player-track {
    margin-bottom: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .tracklist-page .spotify-embed-host {
    min-height: 152px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #121212;
  }

  .tracklist-page .spotify-embed-offscreen {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* ========================================
     Detail Tracklist
     ======================================== */
  .tracklist-page .detail-section {
    flex: 1;
    min-width: 0;
    margin-top: 0;
    opacity: 0;
    animation: detailEnter 0.5s ease 0.3s forwards;
  }

  .tracklist-page .detail-section .tracklist {
    max-height: 72vh;
    overflow-y: auto;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background-color: var(--color-bg);
  }

  .tracklist-page .detail-section.hidden {
    display: none;
    opacity: 0;
    animation: none;
  }

  @keyframes detailEnter {
    to { opacity: 1; }
  }

  .tracklist-page .results-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
    width: 100%;
    position: sticky;
    top: var(--space-sm);
    z-index: 10;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
    background-color: color-mix(in srgb, var(--color-bg) 94%, transparent);
    backdrop-filter: blur(6px);
  }

  .tracklist-page .results-header.hidden {
    display: none;
  }

  .tracklist-page .set-title {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-xs);
  }

  .tracklist-page .set-info {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .tracklist-page .tracklist-source {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .tracklist-page .tracklist-source.hidden { display: none; }
  .tracklist-page .tracklist-source a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tracklist-page .tracklist-source a:hover { color: var(--color-accent); }

  .tracklist-page .track-count-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 2px var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: 100px;
  }

  .tracklist-page .selection-summary {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding: 2px var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: 100px;
  }

  .tracklist-page .results-actions {
    display: flex;
    gap: var(--space-sm);
    flex-shrink: 0;
    align-items: center;
  }

  /* --- Buttons --- */
  .tracklist-page .primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-sm) var(--space-lg);
    background-color: var(--color-accent);
    color: var(--color-bg);
    border: none;
    border-radius: 4px;
    font-size: var(--text-sm);
    font-family: var(--font-serif);
    cursor: pointer;
    transition: background-color var(--transition-base);
    white-space: nowrap;
    text-decoration: none;
    background-image: none;
  }

  .tracklist-page .primary-btn:hover {
    background-color: var(--color-accent-hover);
    background-image: none;
    background-size: 0;
  }

  .tracklist-page .secondary-btn {
    padding: var(--space-sm) var(--space-lg);
    background-color: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: var(--text-sm);
    font-family: var(--font-serif);
    cursor: pointer;
    transition: border-color var(--transition-base), color var(--transition-base);
    white-space: nowrap;
  }

  .tracklist-page .secondary-btn:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  .tracklist-page .export-selection-pill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding: 2px var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    white-space: nowrap;
  }

  /* --- Tracklist --- */
  .tracklist-page .tracklist {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tracklist-page .track-row {
    display: grid;
    grid-template-columns: 1.5rem 2rem 1fr auto auto auto;
    align-items: center;
    gap: 0 var(--space-sm);
    padding: 6px var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    opacity: 0;
    transform: translateY(4px);
    animation: trackAppear 300ms ease forwards;
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .tracklist-page .track-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 2px;
    border-radius: 2px;
    background: transparent;
  }

  .tracklist-page .track-row.low-confidence::before {
    background: #d97706;
  }

  .tracklist-page .track-row.no-match::before {
    background: #9ca3af;
  }

  .tracklist-page .track-row.low-confidence,
  .tracklist-page .track-row.no-match {
    background-color: rgba(107, 114, 128, 0.045);
  }

  .tracklist-page .track-row:hover {
    background-color: var(--color-surface);
  }

  @keyframes trackAppear {
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- Track number --- */
  .tracklist-page .track-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: right;
    padding-right: var(--space-xs);
  }

  /* --- Track main (title — artist) --- */
  .tracklist-page .track-main {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-left: 2px;
    cursor: default;
  }

  .tracklist-page .track-title {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .tracklist-page .track-sep {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .tracklist-page .track-artist {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .tracklist-page .track-notes {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .tracklist-page .manual-tag {
    display: inline-block;
    margin-left: var(--space-xs);
    padding: 1px 4px;
    border-radius: 100px;
    background-color: #e6f4ea;
    color: #166534;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* --- Badge container --- */
  .tracklist-page .track-badges {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* --- Confidence badges --- */
  .tracklist-page .confidence-badge {
    font-family: var(--font-mono);
    font-size: 9px;
    padding: 1px 6px;
    border-radius: 100px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.4;
    white-space: nowrap;
  }

  .tracklist-page .confidence-high { background-color: #dcfce7; color: #166534; }
  .tracklist-page .confidence-medium { background-color: #fef9c3; color: #854d0e; }
  .tracklist-page .confidence-low, .tracklist-page .confidence-none { background-color: var(--color-surface); color: var(--color-text-muted); }

  /* --- Timestamp --- */
  .tracklist-page .track-ts {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    white-space: nowrap;
  }

  /* --- Action icons --- */
  .tracklist-page .track-actions-cell {
    display: flex;
    gap: 2px;
    align-items: center;
    justify-self: end;
  }

  .tracklist-page .track-icon-btn {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 4px;
    background: none;
    background-image: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--transition-base), background-color var(--transition-base);
    text-decoration: none;
    padding: 0;
  }

  .tracklist-page .track-icon-btn:hover {
    color: var(--color-accent);
    background-color: var(--color-surface);
    background-image: none;
    background-size: 0;
  }

  .tracklist-page .track-icon-btn.play-btn:hover { color: var(--color-text); }
  .tracklist-page .track-icon-btn.spotify-link-btn:hover { color: #1DB954; }

  .tracklist-page .spotify-link-disabled {
    opacity: 0.45;
  }

