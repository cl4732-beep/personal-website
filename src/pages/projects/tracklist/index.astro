        const manualTag = track.manual ? '<span class="manual-tag">Manual</span>' : '';
        const exportedBadge = isExported ? '<span class="exported-badge">Exported</span>' : '';

        const spotifyBtn = track.spotify?.found
          ? `<a href="${escapeAttr(track.spotify.spotifyUrl)}" target="_blank" rel="noopener" class="track-icon-btn spotify-link-btn" aria-label="Open on Spotify" title="Open on Spotify">
               <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
             </a>`
          : `<span class="track-icon-btn spotify-link-btn spotify-link-disabled" aria-label="No Spotify match" title="No Spotify match">
               <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
             </span>`;

        li.innerHTML = `
          <input type="checkbox" class="track-select" data-index="${index}" ${isSelected ? 'checked' : ''} aria-label="Select track ${index + 1}" />
          <span class="track-num">${String(index + 1).padStart(2, '0')}</span>
          <div class="track-main">
            <span class="track-title">${escapeHtml(track.title)}</span>
            <span class="track-sep"> — </span>
            <span class="track-artist">${escapeHtml(track.artist)}${track.notes ? ` <span class="track-notes">[${escapeHtml(track.notes)}]</span>` : ''}</span>
            ${manualTag}
          </div>
          <div class="track-badges">
            ${exportedBadge}
            <span class="confidence-badge ${confidenceClass}">${confidenceLabel}</span>
          </div>
          <span class="track-ts">${escapeHtml(track.timestamp)}</span>
          <div class="track-actions-cell">
            <button class="track-icon-btn play-btn" data-track-idx="${index}" aria-label="Play in Spotify" title="Play in Spotify">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
            ${spotifyBtn}
